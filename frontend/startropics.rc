// Windows resources: the executable's icon (shown by Explorer and the taskbar)
// and version information. The icon is original artwork from tools/make_icon.py.
#include <windows.h>

1 ICON "startropics.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "StarTropics native port"
            VALUE "ProductName",     "StarTropics native port"
            VALUE "FileVersion",     "0.1.0"
            VALUE "ProductVersion",  "0.1.0"
            VALUE "OriginalFilename", "startropics.exe"
            VALUE "LegalCopyright",  "Port tooling MIT licensed. StarTropics is a trademark of Nintendo; no game data is included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
